From 16877187d8e159bbed34beed2ed4bc1ace686c36 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sun, 25 Oct 2026 20:04:52 +1000
Subject: [PVR] Wake the manager thread when it is told to stop

CPVRManager::Stop() sets STATE_STOPPING and calls StopThread(), but
Process() waits in CPVRManagerJobQueue::WaitForJobs(1000) on the
queue's own event, which only a new job, Start() or Clear() sets. So
the thread sleeps out the rest of its 1 second wait before it sees
that the manager is no longer started.

Give the queue a Wake() and call it from Stop() before StopThread().
The event is manual reset, so a wake that lands between the loop's
IsStarted() check and the wait is not lost.

Timed on Linux with pvr.hts, "PVR Manager: Stopping" to "PVR Manager:
Stopped" went from 92-992 ms to 1-2 ms.

Assisted-By: Claude
(cherry picked from commit 84ea1f990b63e441d83c782c9416e923c431d28a)
---
 xbmc/pvr/PVRManager.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/xbmc/pvr/PVRManager.cpp b/xbmc/pvr/PVRManager.cpp
index 28309bbec8..bb546e5835 100644
--- a/xbmc/pvr/PVRManager.cpp
+++ b/xbmc/pvr/PVRManager.cpp
@@ -114,6 +114,8 @@ public:
     return m_triggerEvent.Wait(std::chrono::milliseconds(milliSeconds));
   }
 
+  void Wake() { m_triggerEvent.Set(); }
+
 private:
   CCriticalSection m_critSection;
   CEvent m_triggerEvent{false};
@@ -409,6 +411,7 @@ void CPVRManager::Stop(bool bRestart /* = false */)
   CLog::Log(LOGINFO, "PVR Manager: Stopping");
   SetState(ManagerState::STATE_STOPPING);
 
+  m_pendingUpdates->Wake();
   StopThread();
 }
 
