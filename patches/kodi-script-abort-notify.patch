From 3888949a9ec703faa01ef71f0f2a8c8a4bfb5af0 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sun, 18 Oct 2026 15:45:59 +1000
Subject: [PATCH] [python] Tell scripts run by path that they should stop

CPythonInvoker::stop() only notifies xbmc.Monitor when the script
belongs to an add-on, and only add-on scripts get __xbmcinvokerid__,
which a Monitor uses to match a stop request to its own script. So a
script run by path, such as RunScript(/path/to/script.py) from a keymap,
never sees abortRequested() turn true or waitForAbort() report the
abort on quit or on StopScript(), and only ends when SystemExit is
raised 5 seconds later.

The add-on check in stop() dates from when monitors were matched by
add-on id and an empty id meant every monitor, so notifying for a script
without an add-on would have stopped them all. ae9956b70d switched the
matching to the invoker id but added __xbmcinvokerid__ behind the same
add-on check. Set it for every script, and notify the script's monitors
whenever it is stopped.
---
 xbmc/interfaces/python/PythonInvoker.cpp | 23 ++++++++++++-----------
 1 file changed, 12 insertions(+), 11 deletions(-)

diff --git a/xbmc/interfaces/python/PythonInvoker.cpp b/xbmc/interfaces/python/PythonInvoker.cpp
index 78a13c7c77..5c982a1b1a 100644
--- a/xbmc/interfaces/python/PythonInvoker.cpp
+++ b/xbmc/interfaces/python/PythonInvoker.cpp
@@ -485,16 +485,13 @@ bool CPythonInvoker::stop(bool abort)
       setState(InvokerStateStopping);
       lock.unlock();
 
-      //tell xbmc.Monitor to call onAbortRequested(). That needs no Python, but taking the GIL
-      //here finds a script stuck holding it before the 5 s wait below.
+      // wake xbmc.Monitor's waitForAbort() and abortRequested(). That needs no Python, but taking
+      // the GIL here finds a script stuck holding it before the 5 s wait below.
       const auto abortNotify = [this]
       {
-        if (m_addon)
-        {
-          CLog::Log(LOGDEBUG, "CPythonInvoker({}, {}): trigger Monitor abort request", GetId(),
-                    m_sourceFile);
-          AbortNotification();
-        }
+        CLog::Log(LOGDEBUG, "CPythonInvoker({}, {}): trigger Monitor abort request", GetId(),
+                  m_sourceFile);
+        AbortNotification();
         return false;
       };
       if (!python.RunWithGil(abortNotify))
@@ -694,11 +691,17 @@ void CPythonInvoker::onInitialization()
 
 void CPythonInvoker::onPythonModuleInitialization(void* moduleDict)
 {
-  if (m_addon.get() == NULL || moduleDict == NULL)
+  if (moduleDict == NULL)
     return;
 
   PyObject* moduleDictionary = (PyObject*)moduleDict;
 
+  // xbmc.Monitor uses it to receive this script's abort request, add-on or not
+  PyDict_SetItemString(moduleDictionary, "__xbmcinvokerid__", PyLong_FromLong(GetId()));
+
+  if (m_addon.get() == NULL)
+    return;
+
   PyDict_SetItemString(moduleDictionary, "__xbmcaddonid__",
                        PyObjectPtr(PyUnicode_FromString(m_addon->ID().c_str())).get());
 
@@ -706,8 +709,6 @@ void CPythonInvoker::onPythonModuleInitialization(void* moduleDict)
   PyDict_SetItemString(moduleDictionary, "__xbmcapiversion__",
                        PyObjectPtr(PyUnicode_FromString(version.asString().c_str())).get());
 
-  PyDict_SetItemString(moduleDictionary, "__xbmcinvokerid__", PyLong_FromLong(GetId()));
-
   CLog::Log(LOGDEBUG,
             "CPythonInvoker({}, {}): instantiating addon using automatically obtained id of \"{}\" "
             "dependent on version {} of the xbmc.python api",
