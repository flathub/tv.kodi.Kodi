 xbmc/network/IWSDiscovery.h                         |  2 +-
 xbmc/network/NetworkServices.cpp                    |  8 ++++----
 xbmc/network/NetworkServices.h                      |  2 +-
 xbmc/platform/posix/filesystem/SMBWSDiscovery.cpp   |  6 +++---
 xbmc/platform/posix/filesystem/SMBWSDiscovery.h     |  2 +-
 .../posix/filesystem/SMBWSDiscoveryListener.cpp     | 13 +++++++++----
 .../posix/filesystem/SMBWSDiscoveryListener.h       |  5 ++++-
 xbmc/platform/win32/network/WSDiscoveryWin32.cpp    |  6 +++---
 xbmc/platform/win32/network/WSDiscoveryWin32.h      |  2 +-
 9 files changed, 27 insertions(+), 19 deletions(-)

diff --git a/xbmc/network/IWSDiscovery.h b/xbmc/network/IWSDiscovery.h
index 47142dcd7e..94d304089f 100644
--- a/xbmc/network/IWSDiscovery.h
+++ b/xbmc/network/IWSDiscovery.h
@@ -17,7 +17,7 @@ class IWSDiscovery
 public:
   virtual ~IWSDiscovery() = default;
   virtual bool StartServices() = 0;
-  virtual bool StopServices() = 0;
+  virtual bool StopServices(bool bWait) = 0;
   virtual bool IsRunning() = 0;
 
   static std::unique_ptr<IWSDiscovery> GetInstance();
diff --git a/xbmc/network/NetworkServices.cpp b/xbmc/network/NetworkServices.cpp
index eef3167886..849cb33e48 100644
--- a/xbmc/network/NetworkServices.cpp
+++ b/xbmc/network/NetworkServices.cpp
@@ -477,7 +477,7 @@ bool CNetworkServices::OnSettingChanging(const std::shared_ptr<const CSetting>&
         return false;
     }
     else
-      return StopWSDiscovery();
+      return StopWSDiscovery(true);
   }
 #endif // HAS_FILESYSTEM_SMB
 
@@ -598,7 +598,7 @@ void CNetworkServices::Stop(bool bWait)
   StopJSONRPCServer(bWait);
   StopAirPlayServer(bWait);
   StopAirTunesServer(bWait);
-  StopWSDiscovery();
+  StopWSDiscovery(bWait);
 }
 
 bool CNetworkServices::StartServer(enum ESERVERS server, bool start)
@@ -1245,13 +1245,13 @@ bool CNetworkServices::IsWSDiscoveryRunning()
   return false;
 }
 
-bool CNetworkServices::StopWSDiscovery()
+bool CNetworkServices::StopWSDiscovery(bool bWait)
 {
 #if defined(HAS_FILESYSTEM_SMB)
   if (!IsWSDiscoveryRunning())
     return true;
 
-  CServiceBroker::GetWSDiscovery().StopServices();
+  CServiceBroker::GetWSDiscovery().StopServices(bWait);
 
   return true;
 #endif // HAS_FILESYSTEM_SMB
diff --git a/xbmc/network/NetworkServices.h b/xbmc/network/NetworkServices.h
index cd4afd6012..ac51af805d 100644
--- a/xbmc/network/NetworkServices.h
+++ b/xbmc/network/NetworkServices.h
@@ -101,7 +101,7 @@ public:
 
   bool StartWSDiscovery();
   bool IsWSDiscoveryRunning();
-  bool StopWSDiscovery();
+  bool StopWSDiscovery(bool bWait);
 
 private:
   CNetworkServices(const CNetworkServices&);
diff --git a/xbmc/platform/posix/filesystem/SMBWSDiscovery.cpp b/xbmc/platform/posix/filesystem/SMBWSDiscovery.cpp
index 31ef921ba0..e7cb7123ca 100644
--- a/xbmc/platform/posix/filesystem/SMBWSDiscovery.cpp
+++ b/xbmc/platform/posix/filesystem/SMBWSDiscovery.cpp
@@ -49,12 +49,12 @@ CWSDiscoveryPosix::CWSDiscoveryPosix()
 
 CWSDiscoveryPosix::~CWSDiscoveryPosix()
 {
-  StopServices();
+  StopServices(true);
 }
 
-bool CWSDiscoveryPosix::StopServices()
+bool CWSDiscoveryPosix::StopServices(bool bWait)
 {
-  m_WSDListenerUDP->Stop();
+  m_WSDListenerUDP->Stop(bWait);
 
   return true;
 }
diff --git a/xbmc/platform/posix/filesystem/SMBWSDiscovery.h b/xbmc/platform/posix/filesystem/SMBWSDiscovery.h
index e9a785cf48..568534e58d 100644
--- a/xbmc/platform/posix/filesystem/SMBWSDiscovery.h
+++ b/xbmc/platform/posix/filesystem/SMBWSDiscovery.h
@@ -51,7 +51,7 @@ public:
   // IWSDiscovery interface methods
   ~CWSDiscoveryPosix() override;
   bool StartServices() override;
-  bool StopServices() override;
+  bool StopServices(bool bWait) override;
   bool IsRunning() override;
 
   /*
diff --git a/xbmc/platform/posix/filesystem/SMBWSDiscoveryListener.cpp b/xbmc/platform/posix/filesystem/SMBWSDiscoveryListener.cpp
index 7854eb6491..cb92f50d8b 100644
--- a/xbmc/platform/posix/filesystem/SMBWSDiscoveryListener.cpp
+++ b/xbmc/platform/posix/filesystem/SMBWSDiscoveryListener.cpp
@@ -159,10 +159,14 @@ CWSDiscoveryListenerUDP::~CWSDiscoveryListenerUDP()
 {
 }
 
-void CWSDiscoveryListenerUDP::Stop()
+void CWSDiscoveryListenerUDP::Stop(bool bWait)
 {
-  StopThread(true);
-  CLog::Log(LOGINFO, "CWSDiscoveryListenerUDP::Stop - Stopped");
+  StopThread(bWait);
+  if (bWait && m_started)
+  {
+    m_started = false;
+    CLog::Log(LOGINFO, "CWSDiscoveryListenerUDP::Stop - Stopped");
+  }
 }
 
 void CWSDiscoveryListenerUDP::Start()
@@ -180,6 +184,7 @@ void CWSDiscoveryListenerUDP::Start()
   // Create thread and set low priority
   Create();
   SetPriority(ThreadPriority::LOWEST);
+  m_started = true;
   CLog::Log(LOGINFO, "CWSDiscoveryListenerUDP::Start - Started");
 }
 
@@ -258,7 +263,7 @@ void CWSDiscoveryListenerUDP::Process()
   while (!m_bStop)
   {
     FD_SET(fd, &rset);
-    timeout.tv_sec = 3;
+    timeout.tv_sec = 1;
     timeout.tv_usec = 0;
     nready = select((fd + 1), &rset, NULL, NULL, &timeout);
 
diff --git a/xbmc/platform/posix/filesystem/SMBWSDiscoveryListener.h b/xbmc/platform/posix/filesystem/SMBWSDiscoveryListener.h
index 7f8f3da4e0..7f3944094b 100644
--- a/xbmc/platform/posix/filesystem/SMBWSDiscoveryListener.h
+++ b/xbmc/platform/posix/filesystem/SMBWSDiscoveryListener.h
@@ -30,7 +30,7 @@ public:
   ~CWSDiscoveryListenerUDP();
 
   void Start();
-  void Stop();
+  void Stop(bool bWait);
 
 protected:
   // CThread
@@ -100,6 +100,9 @@ private:
   // Socket FD for send/recv
   int fd;
 
+  // Only the Stop() that joins a started thread logs that it stopped
+  bool m_started = false;
+
   std::vector<Command> m_commandbuffer;
 
   CCriticalSection crit_commandqueue;
diff --git a/xbmc/platform/win32/network/WSDiscoveryWin32.cpp b/xbmc/platform/win32/network/WSDiscoveryWin32.cpp
index e5ebd71b02..737e441d93 100644
--- a/xbmc/platform/win32/network/WSDiscoveryWin32.cpp
+++ b/xbmc/platform/win32/network/WSDiscoveryWin32.cpp
@@ -209,7 +209,7 @@ std::unique_ptr<IWSDiscovery> IWSDiscovery::GetInstance()
 
 CWSDiscoveryWindows::~CWSDiscoveryWindows()
 {
-  StopServices();
+  StopServices(true);
 }
 
 bool CWSDiscoveryWindows::StartServices()
@@ -238,12 +238,12 @@ bool CWSDiscoveryWindows::StartServices()
   // if get here something has gone wrong
   CLog::Log(LOGERROR, "[WS-Discovery]: Daemon initialization has failed.");
 
-  StopServices();
+  StopServices(true);
 
   return false;
 }
 
-bool CWSDiscoveryWindows::StopServices()
+bool CWSDiscoveryWindows::StopServices(bool bWait)
 {
   if (m_initialized)
   {
diff --git a/xbmc/platform/win32/network/WSDiscoveryWin32.h b/xbmc/platform/win32/network/WSDiscoveryWin32.h
index 0a46f8b1ab..458537603b 100644
--- a/xbmc/platform/win32/network/WSDiscoveryWin32.h
+++ b/xbmc/platform/win32/network/WSDiscoveryWin32.h
@@ -50,7 +50,7 @@ public:
   ~CWSDiscoveryWindows() override;
 
   bool StartServices() override;
-  bool StopServices() override;
+  bool StopServices(bool bWait) override;
   bool IsRunning() override;
 
   bool ThereAreServers();
