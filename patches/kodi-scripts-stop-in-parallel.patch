From 38cf4261cefe8ca0cd69c44519902fc170f112d7 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Thu, 22 Oct 2026 12:45:53 +0200
Subject: [PATCH] [application] Let scripts shut down in parallel on exit

Stopping a script waits until it has finished, so service add-ons shut
down one after another on exit and their shutdown times add up. Notify
all scripts first, so they shut down in parallel.

Drop the "failed to stop ... (may have ended)" message. Stopping only
fails for scripts that are no longer running, which is now the case for
most services, and scripts that do not stop are logged by the invoker.
---
 xbmc/addons/Service.cpp                             | 5 +----
 xbmc/application/Application.cpp                    | 2 ++
 xbmc/interfaces/generic/ScriptInvocationManager.cpp | 7 +++++++
 xbmc/interfaces/generic/ScriptInvocationManager.h   | 7 +++++++
 4 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/xbmc/addons/Service.cpp b/xbmc/addons/Service.cpp
index 13f92ba26b..1c00d9bf8d 100644
--- a/xbmc/addons/Service.cpp
+++ b/xbmc/addons/Service.cpp
@@ -125,9 +125,6 @@ void CServiceAddonManager::Stop(
     const std::map<std::string, int, std::less<>>::value_type& service) const
 {
   CLog::Log(LOGDEBUG, "CServiceAddonManager: stopping {}.", service.first);
-  if (!CScriptInvocationManager::GetInstance().Stop(service.second))
-  {
-    CLog::Log(LOGINFO, "CServiceAddonManager: failed to stop {} (may have ended)", service.first);
-  }
+  CScriptInvocationManager::GetInstance().Stop(service.second);
 }
 }
diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index 9d052900bc..23b1f522b3 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -1704,6 +1704,8 @@ bool CApplication::Stop(int exitCode)
     m_ExitCode = exitCode;
     CLog::Log(LOGINFO, "Stopping all");
 
+    CScriptInvocationManager::GetInstance().NotifyAllScriptsAborting();
+
     // Stop scanning before the job manager is cancelled below
     // otherwise scans underway are not stopped
     CMusicLibraryQueue::GetInstance().CancelAllJobs();
diff --git a/xbmc/interfaces/generic/ScriptInvocationManager.cpp b/xbmc/interfaces/generic/ScriptInvocationManager.cpp
index c6fe84593a..952f379b0e 100644
--- a/xbmc/interfaces/generic/ScriptInvocationManager.cpp
+++ b/xbmc/interfaces/generic/ScriptInvocationManager.cpp
@@ -349,6 +349,13 @@ void CScriptInvocationManager::StopRunningScripts(bool wait /* = false */)
                         });
 }
 
+void CScriptInvocationManager::NotifyAllScriptsAborting()
+{
+  std::unique_lock lock(m_critSection);
+  for (const auto& handler : m_invocationHandlers)
+    handler.second->NotifyScriptAborting(nullptr);
+}
+
 bool CScriptInvocationManager::Stop(const std::string &scriptPath, bool wait /* = false */)
 {
   if (scriptPath.empty())
diff --git a/xbmc/interfaces/generic/ScriptInvocationManager.h b/xbmc/interfaces/generic/ScriptInvocationManager.h
index 6ae97a48ee..4ade3a6e87 100644
--- a/xbmc/interfaces/generic/ScriptInvocationManager.h
+++ b/xbmc/interfaces/generic/ScriptInvocationManager.h
@@ -120,6 +120,13 @@ public:
   */
   void StopRunningScripts(bool wait = false);
 
+  /*!
+   *\brief Tell all running scripts that they are about to be stopped
+   *\note Stopping a script waits until it has finished. Notifying all
+   *      scripts beforehand lets them shut down in parallel.
+   */
+  void NotifyAllScriptsAborting();
+
   bool IsRunning(int scriptId) const;
   bool IsRunning(const std::string& scriptPath) const;
 
