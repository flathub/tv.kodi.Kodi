From d48a8ea4ad3653db8765b30baa87e51455a9097d Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sat, 17 Oct 2026 05:00:27 +1000
Subject: [PATCH] [VideoPlayer] Back off from a demuxer that keeps returning
 nothing

A demuxer with no data yet returns an empty packet, and the player goes
straight back for another. inputstream.adaptive does this for every
sample while its next read is in flight, which normally takes a
fraction of a millisecond. While a download stalls, or trickles in below
the stream's bitrate, the loop keeps a core at 100% for as long as that
lasts.

Once a run of empty packets has lasted more than 1 ms, sleep for an
eighth of how long it has lasted, between 1 and 10 ms. A read that
finishes within 1 ms costs nothing, and a slower one is picked up at
most about an eighth of its length late, so there is no fixed cap on
packets per second. Sleeping for the whole run instead would leave a
sample that takes 10 to 20 ms to decrypt in software, as on a Raspberry
Pi 4, waiting up to its own length again, and the player falls behind.
Any other packet ends the run, and so does idling on full queues. An
empty packet that took longer than 1 ms to read ends the run as well:
the demuxer blocked on input, so it has already paced the loop. A seek
or flush needs no reset of its own, because its first packet ends the
run. Empty packets that replace input the demuxer read and dropped are
marked by the demuxer and end the run too, so channel starts are not
throttled.
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 34 ++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index b956ba92c6..785ccd44b3 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -91,6 +91,13 @@ using namespace std::chrono_literals;
 
 namespace
 {
+// longer than a demuxer takes to hand over data it already has
+constexpr auto EMPTY_PACKET_GRACE = 1ms;
+// same as the idle sleep on full queues
+constexpr auto EMPTY_PACKET_MAX_SLEEP = 10ms;
+// sleep at most 1/N of the run so far, so a slow read is picked up at most 1/N late
+constexpr int EMPTY_PACKET_SLEEP_DIVISOR = 8;
+
 bool IsKnownLanguage(const CLanguageTag& language)
 {
   return !language.IsUndetermined();
@@ -1607,11 +1614,14 @@ void CVideoPlayer::Process()
 
   Prepare();
 
+  std::optional<std::chrono::steady_clock::time_point> emptySince;
+
   while (!m_bAbortRequest)
   {
     // check display lost
     if (m_displayLost)
     {
+      emptySince.reset();
       CThread::Sleep(50ms);
       continue;
     }
@@ -1700,6 +1710,7 @@ void CVideoPlayer::Process()
           m_pDemuxer->SetSpeed(DVD_PLAYSPEED_PAUSE);
         m_demuxerSpeed = DVD_PLAYSPEED_PAUSE;
       }
+      emptySince.reset();
       CThread::Sleep(10ms);
       continue;
     }
@@ -1716,14 +1727,37 @@ void CVideoPlayer::Process()
 
     DemuxPacket* pPacket = NULL;
     CDemuxStream *pStream = NULL;
+    const auto readStart = std::chrono::steady_clock::now();
     ReadPacket(pPacket, pStream);
     if (pPacket && !pStream)
     {
+      const auto now = std::chrono::steady_clock::now();
+      // nothing yet; special packets, dropped input and reads that blocked are progress
+      const bool waiting = pPacket->iStreamId == -1 && !pPacket->m_inputDropped &&
+                           now - readStart <= EMPTY_PACKET_GRACE;
+
       /* probably a empty packet, just free it and move on */
       CDVDDemuxUtils::FreeDemuxPacket(pPacket);
+
+      if (!waiting)
+      {
+        emptySince.reset();
+        continue;
+      }
+
+      // back off in proportion to how long the demuxer has had nothing
+      if (!emptySince)
+        emptySince = now;
+      else if (now - *emptySince > EMPTY_PACKET_GRACE)
+        CThread::Sleep(std::clamp(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                      (now - *emptySince) / EMPTY_PACKET_SLEEP_DIVISOR),
+                                  1ms, EMPTY_PACKET_MAX_SLEEP));
+
       continue;
     }
 
+    emptySince.reset();
+
     if (!pPacket)
     {
       // when paused, demuxer could be be returning empty
