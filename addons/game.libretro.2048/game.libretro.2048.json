            "commit": "d6af9b50323d0da3b684ab75ee63f092b0b839a3"
        }
    ],
    "modules": [
        {
            "name": "2048",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
