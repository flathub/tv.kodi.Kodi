{
    "name": "game.libretro.2048",
    "buildsystem": "cmake-ninja",
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.2048",
            "commit": "5fa039668aafad146c709bf0c18d037eb76a864f"
        }
    ],
    "modules": [
        {
            "name": "2048",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -f Makefile.libretro PREFIX=/app platform=unix",
                "install -s -D -m 755 2048_libretro.so /app/lib/libretro/2048_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/libretro-2048/archive/39333f7b13dc4daea7c151d9c38d22b961246343.tar.gz",
                    "sha256": "6268b7e34bcc107296285354d14bfc2e6110a10df86d5d4c962d9a76c807af2f"
                }
            ]
        }
    ],
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ]
}
