{
    "name": "game.libretro.nestopia",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.nestopia",
            "commit": "36826dcb3a64a747a03a2d65882fa4b330777955"
        }
    ],
    "modules": [
        {
            "name": "libretro-nestopia",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -C libretro/",
                "install -s -D -m 755 libretro/nestopia_libretro.so /app/lib/libretro/nestopia_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/nestopia/archive/930726826ad20346b2d023af0b8f784c8570720e.tar.gz",
                    "sha256": "030a375e1b4c4a49a36b4c39867d3fda3a2acad1525f3648a77b3de40be98dec"
                }
            ]
        }
    ]
}
