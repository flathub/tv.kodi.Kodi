{
    "name": "game.libretro.nestopia",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.nestopia",
            "commit": "a43cb49cba4e8a5dab600a8a707019f39d66735a"
        }
    ],
    "modules": [
        {
            "name": "libretro-nestopia",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -C libretro/",
                "install -s -D -m 755 libretro/nestopia_libretro.so /app/lib/libretro/nestopia_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/nestopia/archive/fc21888478ab372e894d3443f70fd1454e934748.tar.gz",
                    "sha256": "88041c61a0b97b1039a981859efd1c12f91b1b8eb30d1bc3505bb760416c32fd"
                }
            ]
        }
    ]
}
