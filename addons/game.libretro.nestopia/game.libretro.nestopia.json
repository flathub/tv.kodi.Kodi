{
    "name": "game.libretro.nestopia",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.nestopia",
            "commit": "b9ddc248495fe9461caf967f2e0d3998d110df47"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-nestopia",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -C libretro/",
                "install -s -D -m 755 libretro/nestopia_libretro.so /app/lib/libretro/nestopia_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/nestopia/archive/2110d21b7174455ec98948bb474147dea0e3cad0.tar.gz",
                    "sha256": "ed83409b97a547bd3619f830d3033222169c970669cc97353dd6ede30025b160"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.nestopia/b9ddc248495fe9461caf967f2e0d3998d110df47/depends/common/nestopia/0001-Disable-video-filter-by-default.patch",
                    "sha256": "d49a2a8bce6181f44383e5e0ed11b9abb8f9393ce1ddadc3752492818a7a47d0",
                    "dest-filename": "0001-Disable-video-filter-by-default.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "patch -p1 < 0001-Disable-video-filter-by-default.patch"
                    ]
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.nestopia"
    ]
}
