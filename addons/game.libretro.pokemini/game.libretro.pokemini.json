{
    "name": "game.libretro.pokemini",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.pokemini",
            "commit": "46136a63dd2b9a6268c518ae840c2efd7a3ff5cb"
        }
    ],
    "modules": [
        {
            "name": "libretro-pokemini",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -f Makefile.libretro",
                "install -D -m 755 pokemini_libretro.so /app/lib/libretro/pokemini_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/PokeMini/archive/132111b76343559860532a1ccc094f93f1ed5650.tar.gz",
                    "sha256": "53d1266404a823d1cf11b66b0d837c34604fa1623576275e52ec796b663ca2cf"
                }
            ]
        }
    ]
}
