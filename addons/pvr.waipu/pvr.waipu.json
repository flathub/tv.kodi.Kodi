{
    "name": "pvr.waipu",
    "buildsystem": "cmake-ninja",
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/flubshi/pvr.waipu",
            "commit": "cb54b3d1795297659fdd1e20a04ed4fe46090ea2"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "post-install": [
        "install -Dp -m 644 ${FLATPAK_BUILDER_BUILDDIR}/pvr.waipu/LICENSE.txt ${FLATPAK_DEST}/share/licenses/tv.kodi.Kodi/pvr.waipu/LICENSE.txt",
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh pvr.waipu"
    ]
}
