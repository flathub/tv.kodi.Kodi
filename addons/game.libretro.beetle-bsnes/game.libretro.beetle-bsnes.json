{
    "name": "game.libretro.beetle-bsnes",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.beetle-bsnes",
            "commit": "02fb12b07963ccc6866d51bb8fbb298df9146048"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-beetle-bsnes",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app",
                "install -s -D -m 755 mednafen_snes_libretro.so /app/lib/libretro/mednafen_snes_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/beetle-bsnes-libretro/archive/5f05e4c785e936c928ac468e129c55b6f08592cb.tar.gz",
                    "sha256": "7b2ffad2c1abf0c90867ecb707dc91486f4c787c535ae406c343eb429a15c136"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.beetle-bsnes/02fb12b07963ccc6866d51bb8fbb298df9146048/depends/common/beetle-bsnes/0001-Fix-strlcpy-strlcat-fallback-with-glibc-2.38.patch",
                    "sha256": "f5027b984ec7ed4d292a16406c862f32244c6ccd88688d087f8cf3745f1e9526",
                    "dest-filename": "0001-Fix-strlcpy-strlcat-fallback-with-glibc-2.38.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "patch -p1 < 0001-Fix-strlcpy-strlcat-fallback-with-glibc-2.38.patch"
                    ]
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.beetle-bsnes"
    ]
}
