{
    "name": "game.libretro.sameboy",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.sameboy",
            "commit": "366c5b3c64927c702d628c137d270f08806552d4"
        }
    ],
    "modules": [
        {
            "name": "libretro-sameboy",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -C libretro/",
                "install -s -D -m 755 libretro/sameboy_libretro.so /app/lib/libretro/sameboy_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/SameBoy/archive/aa158a889a48b538a0302873704a34577c8eb67d.tar.gz",
                    "sha256": "6d80783ac470c15b5be1060e619eda01079f00c1c42fdfbcc65527b7dcd8b5b7"
                }
            ]
        }
    ]
}
