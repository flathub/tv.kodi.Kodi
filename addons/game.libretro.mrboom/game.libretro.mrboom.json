{
    "name": "game.libretro.mrboom",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.mrboom",
            "commit": "03239964f6463f96817f4d5f99e13ecd9a97a5a1"
        }
    ],
    "modules": [
        {
            "name": "mrboom",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0",
                "arch": {
                    "x86_64": {
                        "env": {
                            "ARCH_FLAGS": "HAVE_NEON=0"
                        }
                    },
                    "aarch64": {
                        "env": {
                            "ARCH_FLAGS": "HAVE_NEON=1"
                        }
                    }
                }
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app $ARCH_FLAGS",
                "install -s -D -m 755 mrboom_libretro.so /app/lib/libretro/mrboom_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/kodi-game/mrboom-libretro/archive/89997083b6f492b5adbae3124a5ed2c784ace6eb.tar.gz",
                    "sha256": "fa84d590cdefa54a892ecba71781f4c0ec091a51fb42525852a23ff3e85c1105"
                }
            ]
        }
    ]
}
