{
    "name": "game.libretro.swanstation",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.swanstation",
            "commit": "b2e704fdc4b9424719ca033fb84bbe47fe98170d"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-swanstation",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "no-make-install": true,
            "post-install": [
                "install -s -D -m 755 swanstation_libretro.so /app/lib/libretro/swanstation_libretro.so"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/swanstation/archive/cc94ebcd38a88a0e90788d7c8bcd764a009a5fa0.tar.gz",
                    "sha256": "5d35a9ea47917b7ad00b4630f1d2e85764e285308820def93b4cce379aa7983f"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.swanstation"
    ]
}
