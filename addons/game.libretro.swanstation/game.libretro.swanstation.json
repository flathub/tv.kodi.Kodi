                    "sha256": "7f5711abd802d38095fc9239250704fa57ebff8c7d69d31f8702d1cc1e3e0256"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.swanstation"
    ]
}
