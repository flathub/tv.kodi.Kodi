{
    "name": "pvr.hdhomerun",
    "buildsystem": "cmake-ninja",
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-pvr/pvr.hdhomerun",
            "commit": "90439d15f6a0e3be8370343b75d7256b16a34c0e"
        }
    ],
    "modules": [
        {
            "name": "libhdhomerun",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j $FLATPAK_BUILDER_N_JOBS SHARED=\"-shared -Wl,-soname,libhdhomerun.so.0\" libhdhomerun.so",
                "install -D -m 755 libhdhomerun.so /app/lib/libhdhomerun.so.0",
                "ln -sf libhdhomerun.so.0 /app/lib/libhdhomerun.so",
                "install -D -m 644 -t /app/include/hdhomerun hdhomerun*.h"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Silicondust/libhdhomerun/archive/20361107/libhdhomerun-20361107.tar.gz",
                    "sha256": "8ca33d1459e1ce79f4c8eac21b0366133737025e0b88f31f5bdded17486d0ac3",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/Silicondust/libhdhomerun/releases/latest",
                        "tag-query": ".tag_name",
                        "timestamp-query": ".published_at",
                        "version-query": "$tag",
                        "url-query": "\"https://github.com/Silicondust/libhdhomerun/archive/\\($tag)/libhdhomerun-\\($version).tar.gz\""
                    }
                }
            ]
        }
    ],
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ]
}
