{
    "name": "game.libretro.prboom",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.prboom",
            "commit": "bd9d8dd1038eac77c06821145961112a930bc993"
        }
    ],
    "modules": [
        {
            "name": "libretro-prboom",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app platform=unix",
                "install -D -m 755 prboom_libretro.so /app/lib/libretro/prboom_libretro.so",
                "install -D -m 644 prboom.wad /app/share/retroarch/system/prboom.wad"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/libretro-prboom/archive/c180d47a5f9f1b5f74be18bf74deb5eccf97057e.tar.gz",
                    "sha256": "2c2f35aef13bfa58cb2f7945059f2fe347db09cab034b873579e224f4dc05563"
                }
            ]
        }
    ]
}
