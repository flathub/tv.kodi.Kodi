{
    "name": "game.libretro",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "cleanup": [
        "/include",
        "*.a",
        "*.la"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro",
            "commit": "8933f8c8a23120560a70e2f68adf630c2f608569"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-common",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0 -fPIC",
                "cxxflags": "-g0 -fPIC"
            },
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/libretro-common/archive/0a2b63d903ea0cc7bac9e759af57db190b4aeadd.tar.gz",
                    "sha256": "cdeba2574bf659cd5b7bff6b4a6fcbe827d93d1beb8cf1ccc598836b25c75852"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro/8933f8c8a23120560a70e2f68adf630c2f608569/depends/common/libretro-common/CMakeLists.txt",
                    "sha256": "e45d4f77e57478ba27e6bcfcab2f7b641061cea24efd836e3d082e45cd0b688f"
                }
            ]
        },
        {
            "name": "rcheevos",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0 -fPIC",
                "cxxflags": "-g0 -fPIC"
            },
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/RetroAchievements/rcheevos/archive/v12.5.0.tar.gz",
                    "sha256": "e6df83de4e18f0a19206e711e1e589624dcfcf6bf529c14f6dd2bb2d1ced983f",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/RetroAchievements/rcheevos/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": "\"https://github.com/RetroAchievements/rcheevos/archive/\" + .tag_name + \".tar.gz\""
                    }
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro/8933f8c8a23120560a70e2f68adf630c2f608569/depends/common/rcheevos/CMakeLists.txt",
                    "sha256": "49a8eb640f10ea35f98880f504048d07865627037bca1402039bb67fe28d1cc9"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro"
    ]
}
