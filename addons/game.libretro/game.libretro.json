                    "sha256": "20e1a2bad376c83c449ac5de2675032c59c3c2e92219532344bebd862faf6134",
                    "dest-filename": "0003-turn-a-subset-on-or-off.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "patch -p1 < 0001-preserve-encore-unlock-times.patch",
                        "patch -p1 < 0002-expose-zero-achievement-progress.patch",
                        "patch -p1 < 0003-turn-a-subset-on-or-off.patch"
                    ]
                }
            ]
