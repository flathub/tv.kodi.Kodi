                        "version-query": ".tag_name",
                        "url-query": "\"https://github.com/RetroAchievements/rcheevos/archive/\" + .tag_name + \".tar.gz\""
                    }
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro/4985b84fcaf17955a1666491eb26999620f109c4/depends/common/rcheevos/CMakeLists.txt",
                    "sha256": "49a8eb640f10ea35f98880f504048d07865627037bca1402039bb67fe28d1cc9"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro/4985b84fcaf17955a1666491eb26999620f109c4/depends/common/rcheevos/0001-preserve-encore-unlock-times.patch",
                    "sha256": "c056d1c852a3d7bbfa56765ecc9544b35c1f3068cd4ee9a859c1e93889d26e4f",
                    "dest-filename": "0001-preserve-encore-unlock-times.patch"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro/4985b84fcaf17955a1666491eb26999620f109c4/depends/common/rcheevos/0002-expose-zero-achievement-progress.patch",
