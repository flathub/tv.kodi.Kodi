{
    "name": "game.libretro.melonds",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.melonds",
            "commit": "d16deaa868c6ddb1c8e1929c4e414b8d6e52120c"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-melonds",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0",
                "ldflags": "-Wl,-z,noexecstack"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app platform=unix DISABLE_OPENGL=1",
                "install -s -D -m 755 melonds_libretro.so /app/lib/libretro/melonds_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/melonDS/archive/66b5d2634cd0a79030562811e6e05f5532f800ba.tar.gz",
                    "sha256": "8fa494f12a8fe7f20a4ab32ac89a1391f079d41a203d02822b8541e71637a22c"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.melonds/d16deaa868c6ddb1c8e1929c4e414b8d6e52120c/depends/common/melonds/0001-Load-the-game-from-its-path-when-the-frontend-gives.patch",
                    "sha256": "418138dbf2972f34f24086d360b4226472ed7bf705a5144fdc924c7f25d957a7",
                    "dest-filename": "0001-Load-the-game-from-its-path-when-the-frontend-gives.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "patch -p1 < 0001-Load-the-game-from-its-path-when-the-frontend-gives.patch"
                    ]
                },
                {
                    "type": "patch",
                    "path": "libretro-melonds-001-allow-building-without-opengl.patch"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.melonds"
    ]
}
