{
    "name": "game.libretro.blastem",
    "only_arches": [
        "x86_64"
    ],
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.blastem",
            "commit": "dbc12958f98547bad59989bbc723d13bfd441832"
        }
    ],
    "modules": [
        {
            "name": "libretro-blastem",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -f Makefile.libretro",
                "install -D -m 755 blastem_libretro.so /app/lib/libretro/blastem_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/blastem/archive/aeb16cd0750fc23ab5e804efeb96f9b207985c41.tar.gz",
                    "sha256": "c5d4c49a3c28ac481aeed85ec5e3b9c6d40c72bdacb44a459db99c09afe6facb"
                }
            ]
        }
    ]
}
