{
    "name": "game.libretro.blastem",
    "only_arches": [
        "x86_64"
    ],
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.blastem",
            "commit": "e40080fb01d8942c3c70e2c366f90487b783f35c"
        }
    ],
    "modules": [
        {
            "name": "libretro-blastem",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -f Makefile.libretro",
                "install -s -D -m 755 blastem_libretro.so /app/lib/libretro/blastem_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/blastem/archive/ab743653ed110eeb7b1fe64d00cc5f9279c2bfec.tar.gz",
                    "sha256": "27ba68065f31314ad29abc6a5514ebf19cdd2a2f24648ffbe360275ccb01de25"
                }
            ]
        }
    ]
}
