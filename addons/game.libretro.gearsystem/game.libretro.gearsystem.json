{
    "name": "game.libretro.gearsystem",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.gearsystem",
            "commit": "29ca8f72277d2ba7291d8b5c38145be84cd31e32"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-gearsystem",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -C platforms/libretro",
                "install -s -D -m 755 platforms/libretro/gearsystem_libretro.so /app/lib/libretro/gearsystem_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/drhelius/Gearsystem/archive/27663b47d04a879eff61f94e2b45e448d43fdb02.tar.gz",
                    "sha256": "eabf9eb915cf6795dc30129df3cecccc3039abf2bd1fea052e8e4be89b1d28ca"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.gearsystem/29ca8f72277d2ba7291d8b5c38145be84cd31e32/depends/common/gearsystem/0001-Explicitly-set-version-variable.patch",
                    "sha256": "2fa9fcd856eb8ad8f370cf6bc4905a9a581a34a36a1b56e8270cf8c2d2effb71",
                    "dest-filename": "0001-Explicitly-set-version-variable.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "patch -p1 < 0001-Explicitly-set-version-variable.patch"
                    ]
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.gearsystem"
    ]
}
