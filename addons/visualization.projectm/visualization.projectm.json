{
    "name": "visualization.projectm",
    "buildsystem": "cmake-ninja",
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/xbmc/visualization.projectm",
            "commit": "8788200c697dc005e768ef9646691f478b5906c3"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "projectm-eval",
            "buildsystem": "cmake-ninja",
            "cleanup": [
                "/include",
                "/lib/cmake",
                "/lib/pkgconfig",
                "*.a"
            ],
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DENABLE_PROJECTM_EVAL_INSTALL=ON"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/projectM-visualizer/projectm-eval",
                    "commit": "22fb0cfd8f2dfbcd2b68f2443e7f44e19b32c09a",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    },
                    "tag": "v1.0.7"
                }
            ]
        },
        {
            "name": "projectm",
            "buildsystem": "cmake-ninja",
            "cleanup": [
                "/bin"
            ],
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DENABLE_SYSTEM_PROJECTM_EVAL=ON",
                "-DENABLE_GLES=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/projectM-visualizer/projectm/archive/e98fca85e57802d27a6d11499642de2a1d5e994e.tar.gz",
                    "sha256": "bab6e9fc5f42b9a760948909efba6ec0921faf87b0a321698bba56d6046b16e3"
                }
            ]
        }
    ],
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_PREFIX_PATH=/app",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons"
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh visualization.projectm"
    ]
}
