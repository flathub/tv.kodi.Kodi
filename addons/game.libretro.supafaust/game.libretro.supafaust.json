{
    "name": "game.libretro.supafaust",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.supafaust",
            "commit": "debe4c19d5182ed34809b75982c70d980a8c79e0"
        }
    ],
