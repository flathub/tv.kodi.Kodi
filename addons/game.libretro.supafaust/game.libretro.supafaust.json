{
    "name": "game.libretro.supafaust",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.supafaust",
            "commit": "ff3d4b3e7a5a620dcfa0e155656b78af6b6336d1"
        }
    ],
    "modules": [
        {
            "name": "libretro-supafaust",
            "buildsystem": "simple",
            "build-options": {
