{
    "name": "game.libretro.mame2000",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.mame2000",
            "commit": "03eb1809ed6840863b679f6c8f0fb5d9cf37e014"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-mame2000",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app",
                "install -s -D -m 755 mame2000_libretro.so /app/lib/libretro/mame2000_libretro.so",
                "install -D -m 644 readme.txt /app/share/licenses/tv.kodi.Kodi/libretro-mame2000/readme.txt"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/mame2000-libretro/archive/181b42e5da0d2f0c7a2e59244f23633ed594de2e.tar.gz",
                    "sha256": "5420ee002c68afda1c54479ba1b80a4810705d7f4c18e5b6165bfd978968152e"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.mame2000"
    ]
}
