From 27905b6b4d37a4f9f45024c7eb02e8e41239484c Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sun, 25 Oct 2026 05:16:59 +1000
Subject: [PATCH] Drop the renderers this build does not include

The core is built without Vulkan, so the Vulkan and paraLLEl-GS
renderers are not there. Auto stays the default: the core tries
desktop OpenGL, then OpenGL ES 3.1, then the software renderer.
---
 game.libretro.lrps2/resources/settings.xml | 2 --
 1 file changed, 2 deletions(-)

diff --git a/game.libretro.lrps2/resources/settings.xml b/game.libretro.lrps2/resources/settings.xml
index 8de6382..3f53a26 100644
--- a/game.libretro.lrps2/resources/settings.xml
+++ b/game.libretro.lrps2/resources/settings.xml
@@ -142,8 +142,6 @@
 						<options>
 							<option label="16316">Auto</option>
 							<option label="30025">OpenGL</option>
-							<option label="30026">Vulkan</option>
-							<option label="30027">paraLLEl-GS</option>
 							<option label="30028">Software (HW)</option>
 							<option label="30029">Software (SW)</option>
 						</options>
-- 
2.55.0

