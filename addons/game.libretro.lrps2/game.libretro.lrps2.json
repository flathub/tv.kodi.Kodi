{
    "name": "game.libretro.lrps2",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.lrps2",
            "commit": "2bfedd43ec3cf3298e35180943a2ee7ec0f2fafc"
        },
        {
            "type": "patch",
            "path": "game.libretro.lrps2-001-default-software-renderer.patch"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-lrps2",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0 -D_GNU_SOURCE",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DPACKAGE_MODE=ON",
                "-DBIN_DIR=lib/libretro",
                "-DUSE_VULKAN=OFF"
            ],
            "builddir": true,
            "post-install": [
                "strip /app/lib/libretro/pcsx2_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/ps2/archive/d4908f40fb32f43c5055852ecaed3c52aa725dce.tar.gz",
                    "sha256": "e2756b4d650cbd15912d7ead03b8f97147247c50e76ec7652efd7d9e79eb0fd1"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.lrps2"
    ]
}
