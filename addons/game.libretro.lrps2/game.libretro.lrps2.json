{
    "name": "game.libretro.lrps2",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.lrps2",
            "commit": "80ef7dc143ddd39428e0bcbd050771e3948ed66e"
        },
        {
            "type": "patch",
            "path": "game.libretro.lrps2-001-drop-unbuilt-renderers.patch"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-lrps2",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0 -D_GNU_SOURCE",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DPACKAGE_MODE=ON",
                "-DBIN_DIR=lib/libretro",
                "-DUSE_VULKAN=OFF"
            ],
            "builddir": true,
            "post-install": [
                "strip /app/lib/libretro/pcsx2_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/ps2/archive/38d3a83f4ecdec977d609ece8afcc527f5f68702.tar.gz",
                    "sha256": "63cc6b89345422d2aefb4085e3e10d461b61c86865f5cff3bd4c56a8dadc0bce"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.lrps2"
    ]
}
