{
    "name": "game.libretro.bluemsx",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.bluemsx",
            "commit": "fbd03d077e905a2cab4cb954a9460956f86691e9"
        }
    ],
    "modules": [
        {
            "name": "libretro-bluemsx",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -f Makefile.libretro",
                "install -D -m 755 bluemsx_libretro.so /app/lib/libretro/bluemsx_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/blueMSX-libretro/archive/0f32f52c48d3e772bfdf0379756f81f00b4e08bc.tar.gz",
                    "sha256": "708565144f365e45100b59a67e4f44782ccc74ab0a3db342f754b1e56e038252"
                }
            ]
        }
    ]
}
