{
    "name": "game.libretro.nx",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.nx",
            "commit": "2827481410aaa52fc47df6091212820f425b1e81"
        }
    ],
    "modules": [
        {
            "name": "libretro-nx",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app",
                "install -D -m 755 nxengine_libretro.so /app/lib/libretro/nxengine_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/nxengine-libretro/archive/a1c45fd4d045333f4ea523e556469b545be82b0a.tar.gz",
                    "sha256": "8e3b1b93a10344c0cb073b704d7f90003a142d1b9b7d2532d774ba61157a2bd5"
                }
            ]
        }
    ]
}
