            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/kodi-game/beetle-psx-libretro/archive/7efcb4d7298dab5731089724af2e5704634b80fe.tar.gz",
                    "sha256": "30139696e6be63f09bbf3db817b93be7750a13b14f910f6dd3e27986c9986ea9"
                }
            ]
        }
    ]
}
