{
    "name": "game.libretro.beetle-psx",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.beetle-psx",
            "commit": "b70c2c70a5bef4c23576a4469fa14fc2927a32c0"
        }
    ],
    "modules": [
        {
            "name": "libretro-beetle-psx",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app HAVE_CDROM=1 LINK_STATIC_LIBCPLUSPLUS=0",
                "install -s -D -m 755 mednafen_psx_libretro.so /app/lib/libretro/mednafen_psx_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/beetle-psx-libretro/archive/c699953afa01bc3f179edbcb14c4cfbeee6107a2.tar.gz",
                    "sha256": "b9562ba7e71119bebd201452db9d7b839bc00a9f6cd3124066a2c4c784826b3c"
                }
            ]
        }
    ]
}
