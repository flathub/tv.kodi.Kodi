{
    "name": "game.libretro.mupen64plus-nx",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.mupen64plus-nx",
            "commit": "8c0f33df26ddc6f8530825ab366677a2b85dad61"
        }
    ],
    "modules": [
        {
            "name": "libretro-mupen64plus-nx",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app platform=unix HAVE_THR_AL=1 HAVE_PARALLEL_RDP=1 LLE=1 HAVE_PARALLEL_RSP=1 FORCE_GLES3=1",
                "install -D -m 755 mupen64plus_next_libretro.so /app/lib/libretro/mupen64plus_next_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/kodi-game/mupen64plus-libretro-nx/archive/eb014557b9c26d798f138f7751c3d9c01a604573.tar.gz",
                    "sha256": "9fb15f117da3bcce8cc8fc6c73b66044517a6cd3f862a36b7710939aa0af41bc"
                }
            ]
        }
    ]
}
