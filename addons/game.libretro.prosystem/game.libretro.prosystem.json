{
    "name": "game.libretro.prosystem",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.prosystem",
            "commit": "563d761aeb667ad5f9334708e1afbb76528e6278"
        }
    ],
    "modules": [
        {
            "name": "libretro-prosystem",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app",
                "install -s -D -m 755 prosystem_libretro.so /app/lib/libretro/prosystem_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/prosystem-libretro/archive/363b6dfbd3e240762e022c2b4897b4fe55722be3.tar.gz",
                    "sha256": "7abed225b58d306bd3988c6950f851aa52a4c7b30d97cedcf626aa18fbf05282"
                }
            ]
        }
    ]
}
