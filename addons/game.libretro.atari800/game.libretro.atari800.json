{
    "name": "game.libretro.atari800",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.atari800",
            "commit": "779cd8428b670b8efb352ebf1e07c87be626887f"
        }
    ],
    "modules": [
        {
            "name": "libretro-atari800",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app",
                "install -D -m 755 atari800_libretro.so /app/lib/libretro/atari800_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/libretro-atari800/archive/9d3bcf283502512052e21c6f1453fbdf7aa3122b.tar.gz",
                    "sha256": "7a32de824c4273d3c1edffe8116a7a60b84cb1a9f4b819df7a558bbadb2424ca"
                }
            ]
        }
    ]
}
