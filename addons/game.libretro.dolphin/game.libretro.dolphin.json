                    "sha256": "61e97c12c3d23f2b6588d99ce61c8ad462b4382f979d14c7a338a11af507edd1",
                    "dest": "Externals/watcher/watcher"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/mutouyun/cpp-ipc/archive/b6cbbc940e25ff898f09a40b107781cef6027b13.tar.gz",
                    "sha256": "33991ccd0620ab1bd244c6e94c519f4bf7e64247cec90a772e20f5eccd468a30",
                    "dest": "Externals/cpp-ipc/cpp-ipc"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/weisslj/cpp-optparse/archive/2265d647232249a53a03b411099863ceca35f0d3.tar.gz",
                    "sha256": "6f38fff3c4d2788eead7a28626b3220cc4c101510fc984678ad55f77756b107e",
                    "dest": "Externals/cpp-optparse/cpp-optparse"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/mgba-emu/mgba/archive/0b40863f64d0940f333fa1c638e75f86f8a26a33.tar.gz",
                    "sha256": "9b59ed1422914f605ce912e9cafcd84d1c5b1bf9abcf0fef1b49e1d810f6f5e5",
                    "dest": "Externals/mGBA/mgba"
                }
            ]
        }
    ],
    "post-install": [
        "rm -rf /app/lib/kodi/addons/game.libretro.dolphin/resources/system/dolphin-emu/Sys",
        "mv /app/lib/libretro/dolphin-emu/Sys /app/lib/kodi/addons/game.libretro.dolphin/resources/system/dolphin-emu/Sys",
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.dolphin"
    ]
}
