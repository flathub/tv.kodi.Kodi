{
    "name": "game.libretro.mesen-s",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.mesen-s",
            "commit": "9aacf2aaa64b2dbc47b74f7e755ff3ef231ce5e4"
        }
    ],
    "modules": [
        {
            "name": "libretro-mesen-s",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -C Libretro/",
                "install -s -D -m 755 Libretro/mesen-s_libretro.so /app/lib/libretro/mesen-s_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/Mesen-S/archive/9e4fdeb9b336470bc96beb8765b2e79c86a2da1e.tar.gz",
                    "sha256": "2e17d972a1b5e678cb4780df8ab53feac13c0c0b908e602ec0cf10619d8bf1a0"
                }
            ]
        }
    ]
}
