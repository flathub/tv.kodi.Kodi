{
    "name": "game.libretro.vbam",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.vbam",
            "commit": "ee6600e8709478ce22a0fa93ef4539e9ea2b02c5"
        }
    ],
    "modules": [
        {
            "name": "libretro-vbam",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DENABLE_LIBRETRO=ON -DENABLE_WX=OFF -DENABLE_LUA=OFF -DENABLE_SDL=OFF -DENABLE_LINK=OFF -DBUILD_TESTING=OFF -DENABLE_LTO=OFF",
                "cmake --build build --target vbam_libretro -j$FLATPAK_BUILDER_N_JOBS",
                "install -s -D -m 755 build/vbam_libretro.so /app/lib/libretro/vbam_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/visualboyadvance-m/visualboyadvance-m/archive/d34ae60213d84e086c6e3b2e08d81c154cd97784.tar.gz",
                    "sha256": "6c336da0b88aa78d224f078e83ff763643304e172e6fd2a5b29f824d6cf5f7d9"
                }
            ]
        }
    ]
}
